{
  "name": "ccometixline-for-pi",
  "version": "0.1.0",
  "description": "CCometixLine powerline footer for Pi Agent, with the original Rust themes",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/xbunax/CCometixLineForPi",
  "keywords": ["pi-package", "pi-extension", "statusline", "powerline"],
  "pi": { "extensions": ["./extensions/index.ts"] },
  "files": ["extensions", "src", "Cargo.toml", "Cargo.lock", "README.md", "README.zh.md"],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:renderer": "cargo build --release --locked"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22.19.0" }
}
